# =========================================================
# Exame Inteligente - Secrets
# Copie este arquivo para .streamlit/secrets.toml (ja no .gitignore)
# e preencha com os dados do Gmail usado para enviar os codigos.
# No Streamlit Cloud, configure as mesmas chaves em Settings > Secrets.
# =========================================================

[smtp]
host = "smtp.gmail.com"
port = "587"
user = "SEU_GMAIL@gmail.com"
password = "SUA_SENHA_DE_APP"
from = "SEU_GMAIL@gmail.com"
starttls = "true"
